DATABASE_URL=sqlite:////data/voz.db
UPLOAD_DIR=/data/uploads
MAX_AUDIO_SIZE_MB=512
MAX_AUDIO_DURATION_SECONDS=7200
DEFAULT_LANGUAGE=pt
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8081","http://127.0.0.1:8081"]
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# Em GPUs com pouca VRAM (ex.: GTX 1650 4 GB), deixe a diarização em cpu.
DIARIZATION_DEVICE=cpu
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HUGGINGFACE_TOKEN=
HF_HOME=/models
HF_HUB_DISABLE_TELEMETRY=1
PYANNOTE_METRICS_ENABLED=0
JOB_LEASE_SECONDS=180
JOB_MAX_ATTEMPTS=3
RETENTION_DAYS=0
